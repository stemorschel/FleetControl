# Origems autorizadas do frontend (separadas por vírgula; use URLs exatas)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Endereço de escuta local. Em hospedagem, configure conforme o provedor.
HOST=127.0.0.1
PORT=3000

# Banco de dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=fleetcontrol

# Gere uma chave aleatória forte para cada ambiente.
# Exemplo de geração: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Credenciais usadas somente para criar o primeiro administrador, se ele ainda não existir.
# Preencha antes de iniciar a API em um banco novo. Use uma senha com pelo menos 12 caracteres.
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
